# Google Analytics & Tag Manager
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Search Console
GOOGLE_SEARCH_CONSOLE_ID=your-verification-code

# Facebook Pixel
FACEBOOK_PIXEL_ID=123456789012345

# Google Ads
GOOGLE_ADS_ID=AW-XXXXXXXXX

# Bing Webmaster
BING_WEBMASTER_ID=your-verification-code

# Yandex Webmaster
YANDEX_WEBMASTER_ID=your-verification-code

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://isleandecho.com
NEXT_PUBLIC_SITE_NAME="ISLE & ECHO"
# Public base URL used for PayHere return/cancel/notify + payment links in emails
NEXT_PUBLIC_BASE_URL=https://isleandecho.com

# PayHere (payment gateway)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# Supabase (required for tours, destinations, admin, chat — copy from Vercel/production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mapbox (required for contact map + tour itinerary maps)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# Resend (transactional email — tours, custom trips, car rentals, contact, updates)
# Create an API key at https://resend.com/api-keys
# Verify your domain, then use a from-address on that domain.
# IMPORTANT: Add these in Vercel → Project → Settings → Environment Variables (Production).
# Do NOT wrap the value in extra quotes in Vercel — use: Isle & Echo <noreply@isleandecho.com>
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Isle & Echo <noreply@isleandecho.com>
ADMIN_EMAIL=info@isleandecho.com
# Optional: verify inbound webhooks from Resend (Email Center → Settings)
RESEND_WEBHOOK_SECRET=

# Without Supabase locally, public content falls back to data/*.json
# Refresh tours, destinations, blog, and site-content from production:
#   npm run sync:data